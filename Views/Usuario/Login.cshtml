@{
    Layout = null;
    ViewData["Title"] = "Avenzo - Iniciar Sesión";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- DEPENDENCIAS DE ESTILOS, TIPOGRAFÍA E ICONOS EXTERNOS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #031527;
            background-image: 
                radial-gradient(circle at 20% 20%, rgba(14, 165, 233, 0.35) 0%, transparent 45%),
                radial-gradient(circle at 80% 80%, rgba(3, 105, 161, 0.3) 0%, transparent 50%),
                radial-gradient(circle at 50% 50%, #06284F 0%, #020F1D 100%);
            position: relative;
            overflow: hidden;
            padding: 1.5rem;
        }

        /* Cuadrícula sutil técnica */
        body::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: 
                linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
            background-size: 36px 36px;
            pointer-events: none;
        }

        /* Tarjeta de Cristal Oscuro (Glassmorphism Puro) */
        .card-glass {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 410px;
            background: rgba(10, 25, 47, 0.65);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 24px;
            padding: 2.75rem 2.25rem 2.5rem;
            box-shadow: 
                0 30px 60px -12px rgba(0, 0, 0, 0.7),
                inset 0 1px 0 rgba(255, 255, 255, 0.15);
        }

        .brand-logo-wrap {
            text-align: center;
            margin-bottom: 2rem;
        }

        .brand-logo-wrap img {
            max-width: 175px;
            height: auto;
            filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.4));
        }

        .input-glass-wrap {
            display: flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 12px;
            padding: 0 0.9rem;
            transition: all 0.25s ease;
        }

        .input-glass-wrap:focus-within {
            background: rgba(255, 255, 255, 0.08);
            border-color: #38BDF8;
            box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.15);
        }

        .input-glass-wrap i.field-icon {
            color: #64748B;
            font-size: 0.95rem;
            margin-right: 0.75rem;
            transition: color 0.2s ease;
        }

        .input-glass-wrap:focus-within i.field-icon {
            color: #38BDF8;
        }

        .input-glass-wrap input {
            border: none !important;
            outline: none !important;
            box-shadow: none !important;
            background: transparent !important;
            padding: 0.75rem 0 !important;
            font-size: 0.92rem;
            color: #FFFFFF !important;
            width: 100%;
        }

        .input-glass-wrap input::placeholder {
            color: #64748B;
        }

        .btn-toggle-eye {
            background: transparent;
            border: none;
            padding: 0 0.25rem;
            color: #64748B;
            cursor: pointer;
            transition: color 0.2s ease;
        }

        .btn-toggle-eye:hover {
            color: #38BDF8;
        }

        .btn-glass-submit {
            background: linear-gradient(135deg, #0284C7 0%, #0369A1 100%);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #FFFFFF;
            font-weight: 600;
            font-size: 0.95rem;
            padding: 0.8rem;
            border-radius: 12px;
            box-shadow: 0 4px 18px rgba(2, 132, 199, 0.4);
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-glass-submit:hover {
            background: linear-gradient(135deg, #0369A1 0%, #0284C7 100%);
            box-shadow: 0 6px 24px rgba(56, 189, 248, 0.45);
            transform: translateY(-1px);
            color: #FFFFFF;
        }

        .form-check-input {
            background-color: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.25);
            cursor: pointer;
        }

        .form-check-input:checked {
            background-color: #0284C7;
            border-color: #38BDF8;
        }
    </style>
</head>
<body>

    <!-- 1. CONTENEDOR DE ACCESO (CARD GLASS) -->
    <div class="card-glass">
        <!-- Logotipo Oficial Avenzo -->
        <div class="brand-logo-wrap">
            <img src="~/images/Avenzo_Logo_Dark.png" alt="Avenzo Logo" />
        </div>

        <form method="post" action="/Usuario/Login" id="loginForm">
            <!-- Correo -->
            <div class="mb-3">
                <label class="form-label small fw-semibold text-light mb-1" style="font-size: 0.8rem;">Correo Electrónico</label>
                <div class="input-glass-wrap">
                    <i class="fa-regular fa-envelope field-icon"></i>
                    <input type="email" name="correo" placeholder="admin@avenzo.com" required autocomplete="email" />
                </div>
            </div>

            <!-- Contraseña -->
            <div class="mb-3">
                <label class="form-label small fw-semibold text-light mb-1" style="font-size: 0.8rem;">Contraseña</label>
                <div class="input-glass-wrap">
                    <i class="fa-solid fa-lock field-icon"></i>
                    <input type="password" id="inputPassword" name="password" placeholder="••••••••" required autocomplete="current-password" />
                    <button type="button" class="btn-toggle-eye" onclick="togglePasswordVisibility()" title="Mostrar u ocultar contraseña">
                        <i id="eyeIcon" class="fa-regular fa-eye"></i>
                    </button>
                </div>
            </div>

            <!-- Recordar sesión -->
            <div class="d-flex align-items-center justify-content-between mb-4 mt-2">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="checkRecordar" />
                    <label class="form-check-label small text-secondary user-select-none" for="checkRecordar" style="color: #94A3B8 !important;">
                        Recordar sesión
                    </label>
                </div>
            </div>

            <!-- Botón Acceder -->
            <button type="submit" class="btn btn-glass-submit w-100" id="btnSubmit">
                <span>Acceder</span>
                <i class="fa-solid fa-arrow-right-to-bracket"></i>
            </button>
        </form>
    </div>

    <!-- 2. CONTROL INTERACTIVO DE CONTRASEÑA Y ESTADO DE ENVÍO -->
    <script>
        function togglePasswordVisibility() {
            const input = document.getElementById('inputPassword');
            const icon = document.getElementById('eyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fa-regular fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fa-regular fa-eye';
            }
        }

        document.getElementById('loginForm').addEventListener('submit', function () {
            const btn = document.getElementById('btnSubmit');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Accediendo...';
        });
    </script>
</body>
</html>