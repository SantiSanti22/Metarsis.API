@model Metarsis.Api.Models.Encuesta
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    // 1. CÁLCULOS CUANTITATIVOS DE AVANCE Y PARTICIPACIÓN
    int limite = Model.LimiteEmpleados > 0 ? Model.LimiteEmpleados : 1;
    int respondidas = ViewBag.TotalRespondidas ?? 0;
    int porcentaje = (respondidas * 100) / limite;
    if (porcentaje > 100) porcentaje = 100;

    // Colección estructurada de avance individual por colaborador[cite: 1, 17]
    var listaEmpleados = ViewBag.ProgresoEmpleados as List<Metarsis.Api.Models.ProgresoEmpleadoViewModel> ?? new List<Metarsis.Api.Models.ProgresoEmpleadoViewModel>();
    
    // Validación de vigencia operativa: la encuesta debe estar activa y dentro de la fecha límite programada[cite: 17]
    bool encuestaAbierta = Model.EstaActiva && Model.FechaCierre > DateTime.Now;
}

<div class="container-fluid mt-2">
    <!-- 1. BARRA DE NAVEGACIÓN Y ACCIÓN DE CIERRE -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a href="/Panel/Encuestas" class="btn btn-sm btn-light text-secondary shadow-sm border">
            <i class="fas fa-arrow-left"></i> Volver a Encuestas
        </a>
        
        @if (encuestaAbierta)
        {
            <form id="formFinalizarEncuesta" action="/Panel/FinalizarEncuestaManual" method="post" class="m-0">
                <input type="hidden" name="encuestaId" value="@Model.EncuestaID" />
                <!-- Botón que activa el modal de Bootstrap -->
                <button type="button" class="btn btn-sm btn-danger shadow-sm border border-danger" data-bs-toggle="modal" data-bs-target="#modalFinalizarConfirm">
                    <i class="fas fa-stop-circle me-1"></i> Finalizar Encuesta
                </button>
            </form>
        }
        else
        {
            <span class="badge bg-secondary px-3 py-2 fs-6 shadow-sm border border-secondary">
                <i class="fas fa-lock me-1"></i> Encuesta Finalizada y Cerrada
            </span>
        }
    </div>

    <!-- 2. CABECERA DESCRIPTIVA DE LA EMPRESA EVALUADA -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h4 class="text-primary fw-bold mb-2">
                        <i class="fas fa-chart-line me-2"></i> Monitoreo en Vivo: @(Model.Empresa?.NombreEmpresa ?? "Empresa")
                    </h4>
                    <p class="text-muted mb-0">Seguimiento de participación de los empleados y estado actual del cuestionario en tiempo real.</p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    @if(encuestaAbierta){
                        <span class="badge bg-primary px-3 py-2 fs-6">
                            <i class="fas fa-spinner fa-spin me-1"></i> Encuesta En Curso
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- 3. TARJETAS DE INDICADORES CLAVE (KPIS DE PARTICIPACIÓN) -->
    <div class="row mb-4">
        <!-- 1. Tarjeta de Empleados -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
                <div class="card-body">
                    <div class="text-muted small fw-bold text-uppercase">Participación Actual</div>
                    <h3 class="fw-bold text-dark mt-2">@respondidas <span class="fs-6 text-muted">/ @Model.LimiteEmpleados emp.</span></h3>
                    <div class="progress mt-3" style="height: 8px;">
                        <div class="progress-bar bg-primary @(encuestaAbierta ? "progress-bar-striped progress-bar-animated" : "")" role="progressbar" style="width: @porcentaje%;"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Tarjeta de Respuestas Totales -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-info border-4 h-100">
                <div class="card-body">
                    <div class="text-muted small fw-bold text-uppercase">Volumen de Datos</div>
                    <h3 class="fw-bold text-dark mt-2">@ViewBag.RespuestasIndividuales <span class="fs-6 text-muted">/ @ViewBag.MetaRespuestas resp.</span></h3>
                    @{
                        int porcentajeDatos = ViewBag.MetaRespuestas > 0 ? (ViewBag.RespuestasIndividuales * 100) / ViewBag.MetaRespuestas : 0;
                    }
                    <div class="progress mt-3" style="height: 8px;">
                        <div class="progress-bar bg-info @(encuestaAbierta ? "progress-bar-striped progress-bar-animated" : "")" role="progressbar" style="width: @porcentajeDatos%;"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Tarjeta de Reactivos -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
                <div class="card-body">
                    <div class="text-muted small fw-bold text-uppercase">Preguntas Evaluadas</div>
                    <h3 class="fw-bold text-dark mt-2">@ViewBag.TotalPreguntas <span class="fs-6 text-muted">reactivos</span></h3>
                </div>
            </div>
        </div>

        <!-- 4. Tarjeta de Cierre -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start @(encuestaAbierta ? "border-warning" : "border-secondary") border-4 h-100">
                <div class="card-body">
                    <div class="text-muted small fw-bold text-uppercase">Fecha de Cierre</div>
                    <h4 class="fw-bold text-dark mt-2">@Model.FechaCierre.ToString("dd/MMM/yyyy")</h4>
                    <p class="text-muted small mt-3 mb-0" style="font-size: 0.75rem;">
                        <i class="fas fa-clock me-1 @(encuestaAbierta ? "text-warning" : "text-secondary")"></i>
                        @(encuestaAbierta ? "Prog. a las 23:59 hrs" : $"Cerrada {Model.FechaCierre:hh:mm tt}")
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. ENLACE DIRECTO DE ACCESO PARA WHATSAPP -->
    <div class="row mb-4">
        <div class="col-lg-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom p-3">
                    <span class="text-primary fw-bold"><i class="fab fa-whatsapp me-2"></i> Enlace de WhatsApp</span>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-light border p-3 mb-0 d-flex justify-content-between align-items-center flex-wrap">
                        <code class="text-success fw-bold">@ViewBag.LinkWhatsApp</code>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. REGISTRO Y SEGUIMIENTO ANÓNIMO DE RESPUESTAS -->
    <div class="row">
        <div class="col-lg-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                    <span class="text-primary fw-bold"><i class="fas fa-list-ul me-2"></i> Registro de Respuestas Recibidas</span>
                    <button class="btn btn-sm btn-outline-secondary" onclick="location.reload()">
                        <i class="fas fa-sync-alt me-1"></i> Actualizar tabla
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" style="border-collapse: collapse;">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Participante (Anónimo)</th>
                                    <th>Última Interacción</th>
                                    <th>Avance</th>
                                    <th>Estatus</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (listaEmpleados.Any())
                                {
                                    int index = 1;
                                    foreach (var empleado in listaEmpleados)
                                    {
                                        string fechaFormat = empleado.UltimaInteraccion.Date == DateTime.Today ? $"Hoy, {empleado.UltimaInteraccion:hh:mm tt}" : empleado.UltimaInteraccion.ToString("dd/MMM/yy, hh:mm tt");
                                        string estatusReal = empleado.PorcentajeAvance >= 100 ? "Completado" : (encuestaAbierta ? "Respondiendo..." : "Incompleto");
                                        string colorClass = empleado.PorcentajeAvance == 100 ? "success" : (encuestaAbierta ? "primary" : "secondary");
                                        string animacion = (empleado.PorcentajeAvance < 100 && encuestaAbierta) ? "progress-bar-striped progress-bar-animated" : "";
                                        string indexPadded = index.ToString("D2");

                                        <tr>
                                            <td class="ps-4 text-muted"><i class="fas fa-user-secret me-2"></i> Empleado #@indexPadded</td>
                                            <td>@fechaFormat</td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <span class="me-2 small fw-bold text-@colorClass">@empleado.PorcentajeAvance%</span>
                                                    <div class="progress" style="width: 60px; height: 5px;">
                                                        <div class="progress-bar bg-@colorClass @animacion" style="width: @empleado.PorcentajeAvance%;"></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><span class="badge bg-@colorClass bg-opacity-10 text-@colorClass border border-@colorClass">@estatusReal</span></td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-outline-primary shadow-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseResp_@indexPadded">
                                                    <i class="fas fa-eye me-1"></i> Ver detalle
                                                </button>
                                            </td>
                                        </tr>

                                        <tr class="collapse bg-light border-bottom" id="collapseResp_@indexPadded">
                                            <td colspan="5" class="p-0">
                                                <div class="p-4">
                                                    <h6 class="fw-bold text-primary mb-3"><i class="fas fa-comment-dots me-2"></i>Historial de Respuestas (Empleado #@indexPadded)</h6>
                                                    <div class="row">
                                                        @foreach (var resp in empleado.Respuestas)
                                                        {
                                                            <div class="col-md-6 mb-3">
                                                                <div class="p-3 bg-white border rounded shadow-sm h-100">
                                                                    <p class="small text-muted fw-bold mb-1">@resp.Pregunta</p>
                                                                    <p class="text-dark mb-0"><strong>R:</strong> @resp.Respuesta</p>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                        index++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center p-5 text-muted">
                                            <i class="fas fa-inbox fa-3x mb-3 opacity-50"></i>
                                            <p>Aún no se han recibido respuestas.</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 6. MODAL INSTITUCIONAL: CONFIRMACIÓN DE FINALIZACIÓN -->
<div class="modal fade" id="modalFinalizarConfirm" tabindex="-1" aria-labelledby="modalFinalizarConfirmLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 14px;">
            <div class="modal-body p-4 text-center">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" 
                     style="background-color: #FEE2E2; width: 64px; height: 64px;">
                    <i class="fas fa-exclamation-triangle fa-2x" style="color: #DC2626;"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">¿Finalizar encuesta ahora?</h5>
                <p class="text-muted small mb-4" style="line-height: 1.5;">
                    Se cerrará el acceso inmediatamente y los colaboradores <strong>ya no podrán enviar más respuestas</strong> por WhatsApp. Esta acción no se puede deshacer.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-light px-4 py-2 border" data-bs-dismiss="modal" style="border-radius: 8px;">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-danger px-4 py-2 fw-medium shadow-sm" 
                            id="btnConfirmarFinalizar"
                            style="border-radius: 8px;"
                            onclick="confirmarEnvioFinalizar()">
                        <i class="fas fa-lock me-1"></i> Sí, finalizar ahora
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function confirmarEnvioFinalizar() {
        const btn = document.getElementById('btnConfirmarFinalizar');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Cerrando acceso...';
        
        document.getElementById('formFinalizarEncuesta').submit();
    }
</script>
}